{
  "name": "Local Notes",
  "short_name": "Notes",
  "description": "A calm, local-first place for notes, wikilinks and team pages.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f7f7f3",
  "theme_color": "#24251f",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New page", "short_name": "New", "url": "/?action=new", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Search", "short_name": "Search", "url": "/?action=search", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
