# The address people will use, e.g. notes.yourcompany.com (DNS must point here)
DOMAIN=notes.example.com
# Shown on the sign-in page and used for the first shared workspace
TEAM_NAME=Acme
# "invite" (default): only the first person can sign up, everyone else needs an invite link
# "open": anyone who can reach the server can create an account
SIGNUP=invite
