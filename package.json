{
  "name": "local-notes-extended",
  "version": "1.4.12",
  "description": "A calm, Notion-style editor for markdown notes with ranked search, DOCX/PDF export, mobile PWA, admin-managed teams and AI.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node server/cli.js",
    "test": "node --test test/*.test.*",
    "app": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "release": "npm run build && electron-builder --publish always"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/jetbrains-mono": "^5.1.0",
    "@fontsource-variable/source-serif-4": "^5.1.0",
    "@hocuspocus/provider": "^4.9.0",
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-bubble-menu": "^2.27.3",
    "@tiptap/extension-code-block-lowlight": "^2.27.3",
    "@tiptap/extension-collaboration": "^2.27.3",
    "@tiptap/extension-collaboration-cursor": "^2.27.3",
    "@tiptap/extension-hard-break": "^2.27.3",
    "@tiptap/extension-highlight": "^2.27.3",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-italic": "^2.27.3",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/extension-table": "^2.27.3",
    "@tiptap/extension-table-cell": "^2.27.3",
    "@tiptap/extension-table-header": "^2.27.3",
    "@tiptap/extension-table-row": "^2.27.3",
    "@tiptap/extension-task-item": "^2.27.3",
    "@tiptap/extension-task-list": "^2.27.3",
    "@tiptap/extension-text": "^2.27.3",
    "@tiptap/extension-text-style": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "@tiptap/suggestion": "^2.27.3",
    "d3-force": "^3.0.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "lowlight": "^3.1.0",
    "lucide": "^0.460.0",
    "markdown-it-mark": "^4.0.0",
    "prosemirror-markdown": "^1.13.0",
    "tiptap-markdown": "^0.8.10",
    "yjs": "^13.6.33"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "docx": "^9.16.0",
    "electron-updater": "^6.3.9",
    "image-size": "^2.1.0",
    "markdown-it": "^14.1.0",
    "pdfkit": "^0.17.0"
  },
  "productName": "Local Notes Extended",
  "author": {
    "name": "Local Notes Extended",
    "email": "support@superfooduk.com"
  },
  "homepage": "https://harshid-lgtm.github.io/local-notes-extended/",
  "repository": {
    "type": "git",
    "url": "https://github.com/harshid-lgtm/local-notes-extended.git"
  },
  "license": "MIT",
  "main": "electron/main.js",
  "build": {
    "appId": "io.github.harshidlgtm.localnotesextended",
    "productName": "Local Notes Extended",
    "copyright": "Copyright © 2026 Local Notes Extended",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "server/**",
      "shared/**",
      "public/**",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "harshid-lgtm",
        "repo": "local-notes-extended",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "Local-Notes-Extended-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Local Notes Extended",
      "uninstallDisplayName": "Local Notes Extended"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "Local-Notes-Extended-${version}-mac.${ext}",
      "hardenedRuntime": true,
      "darkModeSupport": true,
      "identity": "-"
    },
    "dmg": {
      "title": "Local Notes Extended ${version}",
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 410,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 560,
        "height": 380
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "artifactName": "Local-Notes-Extended-${version}-${arch}.${ext}",
      "synopsis": "Beautiful markdown notes",
      "maintainer": "Local Notes Extended <support@superfooduk.com>"
    }
  }
}
